{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Configuration Schema",
  "type": "object",

  "required": ["TaskScheduler", "paths"],

  "properties": {
    "TaskScheduler": {
      "type": "object",
      "required": [
        "config_version",
        "mode",
        "features",
        "gui",
        "safety",
        "install"
      ],
      "properties": {
        "config_version": { "type": "string" },

        "mode": {
          "type": "string",
          "enum": ["developer", "production", "portable"]
        },

        "features": {
          "type": "object",
          "required": ["cron", "systemd", "env_manager", "log_viewer", "alias_detection"],
          "properties": {
            "cron": {
              "type": "object",
              "required": [
                "enabled",
                "editable",
                "columns",
                "readonly",
                "stretch_last",
                "autosize",
                "status_labels"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "editable": { "type": "boolean" },
                "columns": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "readonly": { "type": "boolean" },
                "stretch_last": { "type": "boolean" },
                "autosize": { "type": "boolean" },
                "status_labels": {
                  "type": "object",
                  "required": ["enabled", "disabled"],
                  "properties": {
                    "enabled": { "type": "string" },
                    "disabled": { "type": "string" }
                  }
                }
              }
            },

            "systemd": {
              "type": "object",
              "required": [
                "enabled",
                "editable",
                "columns",
                "readonly",
                "stretch_last",
                "autosize",
                "status_labels"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "editable": { "type": "boolean" },
                "columns": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "readonly": { "type": "boolean" },
                "stretch_last": { "type": "boolean" },
                "autosize": { "type": "boolean" },
                "status_labels": {
                  "type": "object",
                  "required": ["active", "inactive"],
                  "properties": {
                    "active": { "type": "string" },
                    "inactive": { "type": "string" }
                  }
                }
              }
            },

            "env_manager": {
              "type": "object",
              "required": [
                "enabled",
                "editable",
                "columns",
                "readonly",
                "stretch_last",
                "autosize"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "editable": { "type": "boolean" },
                "columns": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "readonly": { "type": "boolean" },
                "stretch_last": { "type": "boolean" },
                "autosize": { "type": "boolean" }
              }
            },

            "log_viewer": { "type": "boolean" },
            "alias_detection": { "type": "boolean" }
          }
        },

        "gui": {
          "type": "object",
          "required": ["theme", "grid_layout", "editable_fields"],
          "properties": {
            "theme": { "type": "string" },
            "grid_layout": { "type": "string" },
            "editable_fields": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },

        "safety": {
          "type": "object",
          "required": [
            "warn_on_alias",
            "warn_on_relative_paths",
            "validate_before_save",
            "require_explicit_path"
          ],
          "properties": {
            "warn_on_alias": { "type": "boolean" },
            "warn_on_relative_paths": { "type": "boolean" },
            "validate_before_save": { "type": "boolean" },
            "require_explicit_path": { "type": "boolean" }
          }
        },

        "install": {
          "type": "object",
          "required": ["mode", "portable_root"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["base", "portable"]
            },
            "portable_root": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },

    "paths": {
      "type": "object",
      "required": [
        "config_root",
        "data_root",
        "temp_root",
        "export_root",
        "portable_root",
        "plugins",
        "backups"
      ],
      "properties": {
        "config_root": { "type": "string" },
        "data_root": { "type": "string" },
        "temp_root": { "type": "string" },
        "export_root": { "type": "string" },
        "portable_root": { "type": ["string", "null"] },
        "plugins": { "type": "string" },
        "backups": { "type": "string" }
      }
    }
  }
}
